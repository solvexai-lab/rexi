# LEXI UAT Environment Configuration
# Copy this file to .env.local for UAT testing

# Environment Indicator
NEXT_PUBLIC_ENV=uat
NEXT_PUBLIC_APP_VERSION=2.0.0-uat

# Supabase (UAT Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-uat-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-uat-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-uat-service-role-key

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Feature Flags for UAT
NEXT_PUBLIC_ENABLE_DEBUG_MODE=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true

# Rate Limiting (relaxed for UAT)
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_ENABLED=false

# Logging
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
